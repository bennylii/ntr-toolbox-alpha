{
  "note": "内置保护预设库（对齐 LinguaGacha builtin/text_preserve/preset，2026-10；独立实现，数据为互操作契约）。base 恒用；kag/renpy/rpgmaker/wolf 由 config.textPreserve.preset 选择。checkOnly 项只用于质检比对，不进翻译预处理链。",
  "base": [
    {
      "src": "<br>",
      "info": "换行符 Line break"
    },
    {
      "src": "\\s",
      "info": "空白符 Whitespace",
      "checkOnly": true
    },
    {
      "src": "lg-uri/\\d+",
      "info": "资源引用 Resource URI",
      "checkOnly": true
    }
  ],
  "kag": [
    {
      "src": "\\{[^\\{\\p{Script=Han}\\p{Script=Hiragana}\\p{Script=Katakana}\\p{Script=Hangul}]*?\\}",
      "info": "{=2.3}"
    },
    {
      "src": "\\[[^\\[\\p{Script=Han}\\p{Script=Hiragana}\\p{Script=Katakana}\\p{Script=Hangul}]*?\\]",
      "info": "[renpy.version_only]"
    }
  ],
  "renpy": [
    {
      "src": "\\{[^\\{\\p{Script=Han}\\p{Script=Hiragana}\\p{Script=Katakana}\\p{Script=Hangul}]*?\\}",
      "info": "{=2.3}"
    },
    {
      "src": "\\[[^\\[\\p{Script=Han}\\p{Script=Hiragana}\\p{Script=Katakana}\\p{Script=Hangul}]*?\\]",
      "info": "[renpy.version_only]"
    }
  ],
  "rpgmaker": [
    {
      "src": "<.+?:.+?>",
      "info": "<sample:123>"
    },
    {
      "src": "en\\(.{0,8}[vs]\\[\\d+\\].{0,16}\\)",
      "info": "en(!s[123]) en(v[123] >= 1)"
    },
    {
      "src": "if\\(.{0,8}[vs]\\[\\d+\\].{0,16}\\)",
      "info": "if(!s[123]) if(v[123] >= 1)"
    },
    {
      "src": "[<【]{0,1}[/\\\\][a-z]{1,8}[<\\[][a-z\\d]{0,16}[>\\]][>】]{0,1}",
      "info": "/c[xy123] \\bc[xy123] <\\bc[xy123]>【/c[xy123]】"
    },
    {
      "src": "%\\d+",
      "info": "%1 %2"
    },
    {
      "src": "@\\d+",
      "info": "WOLF 角色 ID"
    },
    {
      "src": "\\\\[cus]db\\[.+?:.+?:.+?\\]",
      "info": "WOLF 数据库变量"
    },
    {
      "src": "\\\\f[rbi]",
      "info": "文本重置、文本加粗、文本倾斜"
    },
    {
      "src": "\\\\[\\{\\}]",
      "info": "字体放大、字体缩小"
    },
    {
      "src": "\\\\\\$",
      "info": "打开金币框"
    },
    {
      "src": "\\\\\\.",
      "info": "等待 0.25 秒"
    },
    {
      "src": "\\\\\\|",
      "info": "等待 1.00 秒"
    },
    {
      "src": "\\\\!",
      "info": "等待按钮按下"
    },
    {
      "src": "\\\\>",
      "info": "在同一行显示文字"
    },
    {
      "src": "\\\\<",
      "info": "取消显示所有文字"
    },
    {
      "src": "\\\\\\^",
      "info": "显示文本后不需要等待"
    },
    {
      "src": "[/\\\\][a-z]{1,8}(?=<.{0,16}>|\\[.{0,16}\\])",
      "info": "/C<> \\FS<> /C[] \\FS[] 中 <> [] 前的部分"
    },
    {
      "src": "\\\\[a-z](?=[^a-z<>\\[\\]])",
      "info": "单字母转义符"
    }
  ],
